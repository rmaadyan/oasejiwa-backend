// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  USER
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  role              Role      @default(USER)
  isEmailVerified   Boolean   @default(false)
  isProfileComplete Boolean   @default(false)
  isFirstLogin      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authProvider        AuthProvider?
  passwordResets      PasswordReset[]
  userProfile         UserProfile?
  psychologistProfile PsychologistProfile?
  emailVerifications   EmailVerification[]
}

model AuthProvider {
  id           String   @id @default(uuid())
  userId       String   @unique
  provider     String
  providerId   String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  fullName  String?
  birthday  DateTime?
  gender    Gender?
  country   String?
  city      String?
  fullAddress   String?
  phone     String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychologistProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  sipp      String
  str       String
  about     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations      Education[]
  experiences     Experience[]
  specializations Specialization[]
  expertises      Expertise[]
  schedules       Schedule[]
}

model Education {
  id             String   @id @default(uuid())
  psychologistId String
  degree         String
  institution    String
  city           String
  startYear      Int
  endYear        Int
  createdAt      DateTime @default(now())

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Experience {
  id             String   @id @default(uuid())
  psychologistId String
  name          String
  createdAt      DateTime @default(now())

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Specialization {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Expertise {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Schedule {
  id             String   @id @default(uuid())
  psychologistId String
  date           DateTime
  startTime      String
  duration       Int
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model EmailVerification{
  id            String    @id @default(uuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JenisLayanan {
  Konseling
  Workshop
  Training
  Lainnya
}

enum Kategori {
  Paket
  NonPaket
}

enum TesStatus {
  Aktif
  Draft
}

enum ArahItem {
  positif
  negatif
}

model Layanan {
  id          Int          @id @default(autoincrement())
  nama        String       @unique
  jenis       JenisLayanan
  kategori    Kategori
  deskripsi   String?
  catatan     String?
  durasiMenit Int
  harga       Int
  status      String       @default("Aktif")
  gambar      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bookings Booking[]
}

model Tes {
  id              Int               @id @default(autoincrement())
  nama            String
  jumlah          Int
  status          TesStatus         @default(Draft)
  deskripsi       String
  penjelasanHasil String
  jenis           String?
  coverUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  pertanyaan      Pertanyaan[]
  likertOptions   LikertOption[]
  kategori        DiagnosisKategori[]
  sectionKategori SectionKategori[]
  attempts        TestAttempt[]
}

model Pertanyaan {
  id      String   @id @default(uuid())
  teks    String
  arah    ArahItem
  section String?
  urutan  Int
  tesId   Int
  tes     Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model LikertOption {
  id    String @id @default(uuid())
  label String
  value Int
  tesId Int
  tes   Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model DiagnosisKategori {
  id        String  @id @default(uuid())
  nama      String
  minPersen Float
  maxPersen Float
  deskripsi String?
  result    String?
  tesId     Int
  tes       Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model SectionKategori {
  id          String  @id @default(uuid())
  sectionNama String
  nama        String
  minSkor     Int
  maxSkor     Int
  deskripsi   String?
  tesId       Int
  tes         Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

