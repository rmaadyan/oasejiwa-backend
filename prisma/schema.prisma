generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum JenisLayanan {
  Konseling
  Workshop
  Training
  Lainnya
}

enum Kategori {
  Paket
  NonPaket
}

enum BookingStatus {
  PENDING_DP
  WAITING_APPROVAL
  APPROVED
  REJECTED
  FULLY_PAID
  COMPLETED
  CANCELLED
}

enum PaymentType {
  DOWN_PAYMENT
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum TesStatus {
  Aktif
  Draft
}

enum ArahItem {
  positif
  negatif
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  role              Role     @default(USER)
  isEmailVerified   Boolean  @default(false)
  isProfileComplete Boolean  @default(false)
  isFirstLogin      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  authProvider        AuthProvider?
  passwordResets      PasswordReset[]
  userProfile         UserProfile?
  psychologistProfile PsychologistProfile?
  emailVerifications  EmailVerification[]

  bookings       Booking[]       @relation("UserBookings")
  adminApprovals Booking[]       @relation("AdminApprovals")
  reviews        BookingReview[] @relation("UserReviews")

  sessionNotes      SessionNote[]
  medicalRecord     PatientMedicalRecord?
  emergencyContacts EmergencyContact[]
}

model AuthProvider {
  id           String   @id @default(uuid())
  userId       String   @unique
  provider     String
  providerId   String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String?
  birthday    DateTime?
  gender      Gender?
  country     String?
  city        String?
  fullAddress String?
  phone       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientMedicalRecord {
  id                String   @id @default(uuid())
  userId            String   @unique
  diagnosis         String[] @default([])
  currentMedication String[] @default([])
  allergies         String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  relation  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PsychologistProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String
  sipp      String
  str       String
  about     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations      Education[]
  experiences     Experience[]
  specializations Specialization[]
  expertises      Expertise[]
  schedules       Schedule[]
  sessionNotes    SessionNote[]
  bookings        Booking[]        @relation("PsychologistBookings")
  reviews         BookingReview[]  @relation("PsychologistReviews")
}

model Education {
  id             String   @id @default(uuid())
  psychologistId String
  degree         String
  institution    String
  city           String
  startYear      Int
  endYear        Int
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Experience {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Specialization {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Expertise {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Schedule {
  id             String   @id @default(uuid())
  psychologistId String
  date           DateTime
  startTime      String
  duration       Int
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  sessionNotes  SessionNote[]
  bookings      Booking[]

  @@index([psychologistId])
  @@index([date])
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionNote {
  id                    String  @id @default(uuid())
  psychologistProfileId String
  userId                String
  scheduleId            String?

  subjective String? @db.Text
  objective  String? @db.Text
  assessment String? @db.Text
  plan       String? @db.Text

  riskLevel RiskLevel @default(LOW)

  followUpDate              DateTime?
  nextSessionRecommendation String?   @db.Text
  tags                      String[]  @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  psychologistProfile PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule            Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([psychologistProfileId, createdAt])
  @@index([userId])
  @@index([riskLevel])
  @@index([scheduleId])
}

model Layanan {
  id          Int          @id @default(autoincrement())
  nama        String       @unique
  jenis       JenisLayanan
  kategori    Kategori
  deskripsi   String?
  catatan     String?
  durasiMenit Int
  harga       Int
  status      String       @default("Aktif")
  gambar      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingCode     String        @unique
  userId          String
  psychologistId  String
  serviceId       Int
  scheduleId      String?
  scheduledDate   DateTime      @db.Date
  scheduledTime   String
  totalPrice      Int
  dpAmount        Int
  remainingAmount Int
  status          BookingStatus @default(PENDING_DP)
  adminApprovedBy String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User                @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  psychologist    PsychologistProfile @relation("PsychologistBookings", fields: [psychologistId], references: [id], onDelete: Cascade)
  service         Layanan             @relation(fields: [serviceId], references: [id])
  schedule        Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  approvedByAdmin User?               @relation("AdminApprovals", fields: [adminApprovedBy], references: [id])

  payments Payment[]
  review   BookingReview?

  @@index([userId])
  @@index([psychologistId])
  @@index([serviceId])
  @@index([scheduleId])
  @@index([scheduledDate])
  @@index([status])
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int
  type            PaymentType
  amount          Int
  method          String
  orderId         String        @unique
  virtualAccount  String?
  paymentProofUrl String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  expiredAt       DateTime
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model BookingReview {
  id             Int      @id @default(autoincrement())
  bookingId      Int      @unique
  userId         String
  psychologistId String
  rating         Int
  comment        String?
  isAnonymous    Boolean  @default(false)
  createdAt      DateTime @default(now())

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User                @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  psychologist PsychologistProfile @relation("PsychologistReviews", fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([psychologistId])
  @@index([rating])
}

model Tes {
  id              Int                 @id @default(autoincrement())
  nama            String
  jumlah          Int
  status          TesStatus           @default(Draft)
  deskripsi       String
  penjelasanHasil String
  jenis           String?
  coverUrl        String?
  pertanyaan      Pertanyaan[]
  likertOptions   LikertOption[]
  kategori        DiagnosisKategori[]
  sectionKategori SectionKategori[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Pertanyaan {
  id      String   @id @default(uuid())
  teks    String
  arah    ArahItem
  section String?
  urutan  Int
  tesId   Int
  tes     Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model LikertOption {
  id    String @id @default(uuid())
  label String
  value Int
  tesId Int
  tes   Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model DiagnosisKategori {
  id        String  @id @default(uuid())
  nama      String
  minPersen Float
  maxPersen Float
  deskripsi String?
  result    String?
  tesId     Int
  tes       Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model SectionKategori {
  id          String  @id @default(uuid())
  sectionNama String
  nama        String
  minSkor     Int
  maxSkor     Int
  deskripsi   String?
  tesId       Int
  tes         Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}