generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  role                Role                  @default(USER)
  isEmailVerified     Boolean               @default(false)
  isProfileComplete   Boolean               @default(false)
  isFirstLogin        Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  authProvider        AuthProvider?
  passwordResets      PasswordReset[]
  userProfile         UserProfile?
  psychologistProfile PsychologistProfile?
  emailVerifications  EmailVerification[]
  sessionNotes        SessionNote[]
}

model AuthProvider {
  id           String   @id @default(uuid())
  userId       String   @unique
  provider     String
  providerId   String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String?
  birthday    DateTime?
  gender      Gender?
  country     String?
  city        String?
  fullAddress String?
  phone       String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychologistProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  fullName        String
  sipp            String
  str             String
  about           String
  avatarUrl       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations      Education[]
  experiences     Experience[]
  specializations Specialization[]
  expertises      Expertise[]
  schedules       Schedule[]
  sessionNotes    SessionNote[]
}

model Education {
  id             String               @id @default(uuid())
  psychologistId String
  degree         String
  institution    String
  city           String
  startYear      Int
  endYear        Int
  createdAt      DateTime             @default(now())

  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Experience {
  id             String               @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime             @default(now())

  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Specialization {
  id             String               @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime             @default(now())

  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Expertise {
  id             String               @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime             @default(now())

  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Schedule {
  id             String               @id @default(uuid())
  psychologistId String
  date           DateTime
  startTime      String
  duration       Int
  isAvailable    Boolean              @default(true)
  createdAt      DateTime             @default(now())

  psychologist   PsychologistProfile  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  sessionNote    SessionNote?
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SessionNote {
  id                        String               @id @default(uuid())
  psychologistProfileId     String
  userId                    String
  scheduleId                String?              @unique

  subjective                String?              @db.Text
  objective                 String?              @db.Text
  assessment                String?              @db.Text
  plan                      String?              @db.Text
  riskLevel                 RiskLevel            @default(LOW)

  followUpDate              DateTime?
  nextSessionRecommendation String?              @db.Text
  tags                      String[]             @default([])

  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?

  psychologistProfile       PsychologistProfile  @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule                  Schedule?            @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([psychologistProfileId, createdAt])
  @@index([userId])
  @@index([riskLevel])
}