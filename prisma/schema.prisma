generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUM DEFINITIONS ────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
}

enum RiskLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum JenisLayanan {
  Konseling
  Seminar
  Tes
  Training
  Lainnya
  KonselingPasangan
}

enum Kategori {
  Paket
  NonPaket
}

enum BookingStatus {
  PENDING_DP
  WAITING_APPROVAL
  APPROVED
  REJECTED
  FULLY_PAID
  COMPLETED
  CANCELLED
}

enum PaymentType {
  DOWN_PAYMENT
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum TesStatus {
  Aktif
  Draft
}

enum ArahItem {
  positif
  negatif
}

enum ConsultationStatus {
  ONGOING
  COMPLETED
  REFERRED
}

enum FollowUpPlan {
  CONTINUE_SESSION
  REFER_TO_OTHER
  COMPLETED
}

enum TestResultStatus {
  COMPLETED
  IN_PROGRESS
  DRAFT
}

// ─── USER & AUTH MODELS ──────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  role              Role     @default(USER)
  isEmailVerified   Boolean  @default(false)
  isProfileComplete Boolean  @default(false)
  isFirstLogin      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  authProvider           AuthProvider?
  passwordResets         PasswordReset[]
  userProfile            UserProfile?
  psychologistProfile    PsychologistProfile?
  emailVerifications     EmailVerification[]
  bookings               Booking[]               @relation("UserBookings")
  adminApprovals         Booking[]               @relation("AdminApprovals")
  reviews                BookingReview[]         @relation("UserReviews")
  sessionNotes           SessionNote[]
  medicalRecord          PatientMedicalRecord?
  emergencyContacts      EmergencyContact[]
  tesResults             TesResult[]
  officialMedicalRecords OfficialMedicalRecord[]
}

model AuthProvider {
  id           String   @id @default(uuid())
  userId       String   @unique
  provider     String
  providerId   String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PROFILE MODELS ──────────────────────────────────────────────────────────

model UserProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  fullName        String?
  birthday        DateTime?
  placeOfBirth    String?
  gender          Gender?
  country         String?
  city            String?
  fullAddress     String?
  originalAddress String?
  phone           String?
  occupation      String?
  maritalStatus   String?
  siblingPosition Int?
  totalSiblings   Int?
  isFirstVisit    Boolean?
  educationHistory Json?
  avatarUrl       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychologistProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  fullName           String
  sipp               String
  str                String
  about              String
  avatarUrl          String?
  signatureUrl       String?
  signatureUpdatedAt DateTime?
  signatureMethod    String?
  status             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations             Education[]
  experiences            Experience[]
  specializations        Specialization[]
  expertises             Expertise[]
  schedules              Schedule[]
  sessionNotes           SessionNote[]
  bookings               Booking[]               @relation("PsychologistBookings")
  reviews                BookingReview[]         @relation("PsychologistReviews")
  officialMedicalRecords OfficialMedicalRecord[]
}

model Education {
  id             String   @id @default(uuid())
  psychologistId String
  degree         String
  institution    String
  city           String
  startYear      Int
  endYear        Int
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Experience {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Specialization {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Expertise {
  id             String   @id @default(uuid())
  psychologistId String
  name           String
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model PatientMedicalRecord {
  id                String   @id @default(uuid())
  userId            String   @unique
  diagnosis         String[] @default([])
  currentMedication String[] @default([])
  allergies         String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  relation  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── BOOKING & SCHEDULE MODELS ───────────────────────────────────────────────

model Layanan {
  id          Int          @id @default(autoincrement())
  nama        String       @unique
  jenis       JenisLayanan
  kategori    Kategori
  deskripsi   String?
  catatan     String?
  durasiMenit Int
  harga       Int
  status      String       @default("Aktif")
  gambar      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[] @relation("LayananBookings")
}

model Schedule {
  id             String   @id @default(uuid())
  psychologistId String
  date           DateTime
  startTime      String
  duration       Int
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  sessionNotes SessionNote[]
  bookings     Booking[]           @relation("ScheduleBookings")

  @@index([psychologistId])
  @@index([date])
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingCode     String        @unique
  userId          String
  psychologistId String
  serviceId       Int
  scheduleId      String?
  scheduledDate   DateTime      @db.Date
  scheduledTime   String
  totalPrice      Int
  dpAmount        Int
  remainingAmount Int
  status          BookingStatus @default(PENDING_DP)
  adminApprovedBy String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user                   User                    @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  psychologist           PsychologistProfile     @relation("PsychologistBookings", fields: [psychologistId], references: [id], onDelete: Cascade)
  service                Layanan                 @relation("LayananBookings", fields: [serviceId], references: [id])
  schedule               Schedule?               @relation("ScheduleBookings", fields: [scheduleId], references: [id], onDelete: SetNull)
  approvedByAdmin        User?                   @relation("AdminApprovals", fields: [adminApprovedBy], references: [id])
  consultationForm       ConsultationForm?
  consentForm            ConsentForm?
  sessionNote            SessionNote?
  payments               Payment[]
  review                 BookingReview?
  officialMedicalRecords OfficialMedicalRecord[]

  @@index([userId])
  @@index([psychologistId])
  @@index([serviceId])
  @@index([scheduleId])
  @@index([scheduledDate])
  @@index([status])
}

model Payment {
  id              Int           @id @default(autoincrement())
  bookingId       Int
  type            PaymentType
  amount          Int
  method          String
  orderId         String        @unique
  virtualAccount  String?
  paymentProofUrl String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  expiredAt       DateTime
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model BookingReview {
  id             Int      @id @default(autoincrement())
  bookingId      Int      @unique
  userId         String
  psychologistId String
  rating         Int
  comment        String?
  isAnonymous    Boolean  @default(false)
  createdAt      DateTime @default(now())

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User                @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  psychologist PsychologistProfile @relation("PsychologistReviews", fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([psychologistId])
  @@index([rating])
}

// ─── MEDICAL RECORDS & SESSION NOTES ─────────────────────────────────────────

model SessionNote {
  id                    String   @id @default(uuid())
  psychologistProfileId String
  userId                String
  scheduleId            String?
  bookingId             Int?     @unique

  subjective String? @db.Text
  objective  String? @db.Text
  assessment String? @db.Text
  plan       String? @db.Text

  riskLevel RiskLevel @default(LOW)

  sessionNumber             Int?
  consultationDate          DateTime?
  consultationStatus        ConsultationStatus @default(ONGOING)
  diagnosisSummary          String?            @db.Text
  treatmentApproach         String?            @db.Text
  recommendation            String?            @db.Text
  followUpPlan              FollowUpPlan       @default(CONTINUE_SESSION)
  additionalNotes           String?            @db.Text
  riskReason                String?
  currentMedication         String?
  allergies                 String?

  followUpDate              DateTime?
  nextSessionRecommendation String?            @db.Text
  tags                      String[]           @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  psychologistProfile   PsychologistProfile    @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule              Schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  booking               Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  officialMedicalRecord OfficialMedicalRecord?

  @@index([psychologistProfileId, createdAt])
  @@index([userId])
  @@index([riskLevel])
  @@index([scheduleId])
  @@index([consultationStatus])
  @@index([bookingId])
}

model OfficialMedicalRecord {
  id                    String    @id @default(uuid())
  userId                String
  psychologistProfileId String
  bookingId             Int?
  sessionNoteId         String?   @unique

  sessionNumber         Int?
  consultationDate      DateTime?

  diagnosis             String
  currentMedication     String?
  allergies             String?

  problemSummary        String
  therapyApproach      String
  followUpPlan          String
  nextSessionDate       DateTime?
  additionalNotes       String?

  riskLevel                 RiskLevel @default(LOW)
  riskReason                String?
  followUpDate              DateTime?
  nextSessionRecommendation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologistProfile PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)
  booking             Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sessionNote         SessionNote?        @relation(fields: [sessionNoteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([psychologistProfileId])
  @@index([bookingId])
}

// ─── FORM ENUMS & MODELS ─────────────────────────────────────────────────────

enum ProblemDuration {
  LESS_THAN_1_MONTH
  ONE_TO_3_MONTHS
  THREE_TO_6_MONTHS
  MORE_THAN_6_MONTHS
}

enum SymptomFrequency {
  DAILY
  WEEKLY
  MONTHLY
  RARELY
}

enum DailyImpact {
  NONE
  MILD
  MODERATE
  SEVERE
}

enum SleepQuality {
  GOOD
  FAIR
  POOR
  DISTURBED
}

enum SelfHarmThoughts {
  NEVER
  SOMETIMES
  FREQUENT
}

enum EatingPattern {
  REGULAR
  IRREGULAR
  OVEREATING
  UNDEREATING
}

enum ExerciseFrequency {
  NEVER
  RARELY
  SOMETIMES
  REGULARLY
}

enum StressLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum TherapyPreference {
  DIRECTIVE
  COLLABORATIVE
  NO_PREFERENCE
}

model ConsultationForm {
  id                        Int               @id @default(autoincrement())
  bookingId                 Int               @unique
  mainReason                String
  takingPsychiatricMeds     Boolean
  problemDuration           ProblemDuration
  symptomFrequency          SymptomFrequency
  dailyImpact               DailyImpact
  hasSimilarHistory         Boolean
  similarHistoryDetail      String?
  hasFamilyHistory          Boolean
  familyHistoryDetail       String?
  hasMedicalTreatment       Boolean
  medicalTreatmentDetail    String?
  hasTraumaticEvent         Boolean
  traumaticEventDetail      String?
  sleepQuality              SleepQuality
  selfHarmThoughts          SelfHarmThoughts
  usesAddictiveSubstances   Boolean
  addictiveSubstancesDetail String?
  eatingPattern             EatingPattern
  exerciseFrequency         ExerciseFrequency
  stressLevel               StressLevel
  consultationGoals         String[]
  therapyPreference         TherapyPreference
  createdAt                 DateTime          @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum SignatureType {
  TEXT
  DRAWING
}

model ConsentForm {
  id                     Int           @id @default(autoincrement())
  bookingId              Int           @unique
  consentDate            DateTime      @db.Date
  clientNameConfirmation String
  signatureData          String
  signatureType          SignatureType
  agreedToTerms          Boolean
  ipAddress              String?
  createdAt              DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ─── TES / PSYCHOLOGICAL TEST MODELS ─────────────────────────────────────────

model Tes {
  id              Int                 @id @default(autoincrement())
  nama            String
  jumlah          Int
  status          TesStatus           @default(Draft)
  deskripsi       String
  penjelasanHasil String
  jenis           String?
  coverUrl        String?
  pertanyaan      Pertanyaan[]
  likertOptions   LikertOption[]
  kategori        DiagnosisKategori[]
  sectionKategori SectionKategori[]
  results         TesResult[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Pertanyaan {
  id      String   @id @default(uuid())
  teks    String
  arah    ArahItem
  section String?
  urutan  Int
  image   String?
  tesId   Int
  tes     Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model LikertOption {
  id    String @id @default(uuid())
  label String
  value Int
  tesId Int
  tes   Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model DiagnosisKategori {
  id        String  @id @default(uuid())
  nama      String
  minPersen Float
  maxPersen Float
  deskripsi String?
  result    String?
  tesId     Int
  tes       Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model SectionKategori {
  id          String  @id @default(uuid())
  sectionNama String
  nama        String
  minSkor     Int
  maxSkor     Int
  deskripsi   String?
  tesId       Int
  tes         Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model TesResult {
  id              String           @id @default(uuid())
  userId          String
  tesId           Int
  namaTes         String
  jenisTes        String?
  totalScore      Int
  maxScore        Int
  percentage      Float
  kategoriNama    String
  diagnosis       String?
  detailDiagnosis String?          @db.Text
  interpretasi    String?          @db.Text
  rekomendasi     String[]         @default([])
  status          TestResultStatus @default(COMPLETED)
  sectionScores   Json?
  answers         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tes  Tes  @relation(fields: [tesId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tesId])
  @@index([status])
  @@index([createdAt])
}