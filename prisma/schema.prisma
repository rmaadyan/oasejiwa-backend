generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}


enum JenisLayanan {
  Konseling
  Workshop
  Training
  Lainnya
}

enum Kategori {
  Paket
  NonPaket
}

model Layanan {
  id            Int      @id @default(autoincrement())
  nama          String   @unique
  jenis         JenisLayanan
  kategori      Kategori
  deskripsi     String?
  catatan       String?
  durasiMenit   Int
  harga         Int      // dalam rupiah (misalnya 150000)
  status        String   @default("Aktif")
  gambar        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum TesStatus {
  Aktif
  Draft
}

enum ArahItem {
  positif
  negatif
}

model Tes {
  id              Int                 @id @default(autoincrement())
  nama            String
  jumlah          Int
  status          TesStatus           @default(Draft)
  deskripsi       String
  penjelasanHasil String
  jenis           String?
  coverUrl        String?
  pertanyaan      Pertanyaan[]
  likertOptions   LikertOption[]
  kategori        DiagnosisKategori[]
  sectionKategori SectionKategori[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Pertanyaan {
  id      String   @id @default(uuid())
  teks    String
  arah    ArahItem
  section String?
  urutan  Int
  tesId   Int
  tes     Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model LikertOption {
  id    String @id @default(uuid())
  label String
  value Int
  tesId Int
  tes   Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model DiagnosisKategori {
  id        String @id @default(uuid())
  nama      String
  minPersen Float
  maxPersen Float
  deskripsi String?
  result    String?
  tesId     Int
  tes       Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model SectionKategori {
  id          String @id @default(uuid())
  sectionNama String
  nama        String
  minSkor     Int
  maxSkor     Int
  deskripsi   String?
  tesId       Int
  tes         Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}