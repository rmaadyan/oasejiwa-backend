// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CLIENT
  PSIKOLOG
}

enum Gender {
  L
  P
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

enum TestAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum JenisLayanan {
  Konseling
  Workshop
  Training
  Lainnya
}

enum Kategori {
  Paket
  NonPaket
}

enum TesStatus {
  Aktif
  Draft
}

enum ArahItem {
  positif
  negatif
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role
  phoneNumber  String?  @map("phone_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clientProfile   ClientProfile?
  psikologProfile PsikologProfile?

  @@map("users")
}

model ClientProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender?
  address     String?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  testAttempts TestAttempt[]
  testimonials Testimonial[]

  @@map("client_profiles")
}

model PsikologProfile {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  specialization  String?
  bio             String?
  experienceYears Int?    @map("experience_years")
  education       String?
  rating          Float?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("psikolog_profiles")
}

model Layanan {
  id          Int          @id @default(autoincrement())
  nama        String       @unique
  jenis       JenisLayanan
  kategori    Kategori
  deskripsi   String?
  catatan     String?
  durasiMenit Int
  harga       Int
  status      String       @default("Aktif")
  gambar      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bookings Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  clientId      String        @map("client_id")
  psikologId    String        @map("psikolog_id")
  layananId     Int           @map("layanan_id")
  scheduleStart DateTime      @map("schedule_start")
  scheduleEnd   DateTime      @map("schedule_end")
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  meetingLink   String?       @map("meeting_link")
  notes         String?

  client   ClientProfile   @relation(fields: [clientId], references: [id])
  psikolog PsikologProfile @relation(fields: [psikologId], references: [id])
  layanan  Layanan         @relation(fields: [layananId], references: [id])

  @@map("bookings")
}

model Tes {
  id              Int               @id @default(autoincrement())
  nama            String
  jumlah          Int
  status          TesStatus         @default(Draft)
  deskripsi       String
  penjelasanHasil String
  jenis           String?
  coverUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  pertanyaan      Pertanyaan[]
  likertOptions   LikertOption[]
  kategori        DiagnosisKategori[]
  sectionKategori SectionKategori[]
  attempts        TestAttempt[]
}

model TestAttempt {
  id            String            @id @default(uuid())
  clientId      String            @map("client_id")
  tesId         Int               @map("tes_id")
  status        TestAttemptStatus @default(IN_PROGRESS)
  score         Float?
  resultSummary String?           @map("result_summary")
  startedAt     DateTime          @default(now()) @map("started_at")
  completedAt   DateTime?         @map("completed_at")

  client ClientProfile @relation(fields: [clientId], references: [id])
  tes    Tes           @relation(fields: [tesId], references: [id])

  @@map("test_attempts")
}

model Pertanyaan {
  id      String   @id @default(uuid())
  teks    String
  arah    ArahItem
  section String?
  urutan  Int
  tesId   Int
  tes     Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model LikertOption {
  id    String @id @default(uuid())
  label String
  value Int
  tesId Int
  tes   Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model DiagnosisKategori {
  id        String  @id @default(uuid())
  nama      String
  minPersen Float
  maxPersen Float
  deskripsi String?
  result    String?
  tesId     Int
  tes       Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model SectionKategori {
  id          String  @id @default(uuid())
  sectionNama String
  nama        String
  minSkor     Int
  maxSkor     Int
  deskripsi   String?
  tesId       Int
  tes         Tes     @relation(fields: [tesId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  content     String
  rating      Int
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  client ClientProfile @relation(fields: [clientId], references: [id])

  @@map("testimonials")
}
