# ==============================================================================
# OASE JIWA BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Instruksi:
# 1. Salin file ini menjadi `.env` di root direktori (`cp .env.example .env`).
# 2. Isi nilai variabel sesuai lingkungan (development / staging / production).
# 3. JANGAN PERNAH meng-commit file `.env` yang berisi kredensial asli ke Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port tempat NestJS backend berjalan (Default: 3001)
PORT=3001

# Lingkungan aplikasi: 'development', 'staging', atau 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & PRISMA)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL yang digunakan Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres_user:postgres_password@localhost:5432/oase_jiwa_db?schema=public"

# Variabel untuk inisialisasi kontainer PostgreSQL di Docker Compose
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=oase_jiwa_db

# ------------------------------------------------------------------------------
# 3. FRONTEND & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Origin domain yang diizinkan untuk Cross-Origin Resource Sharing (CORS)
# Pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# URL dasar frontend untuk tautan reset password, verifikasi email, dll.
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key untuk signing JWT token (Gunakan string acak minimal 32 karakter)
JWT_SECRET=your_jwt_super_secret_key_change_me_in_production_32chars

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (LOGIN & REGISTER VIA GOOGLE)
# ------------------------------------------------------------------------------
# Kredensial OAuth dari Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL CONFIGURATION (NODEMAILER)
# ------------------------------------------------------------------------------
# Konfigurasi SMTP untuk pengiriman email (verifikasi, reset password, kredensial)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM="Oase Jiwa <your_email@gmail.com>"

# ------------------------------------------------------------------------------
# 7. CLOUDINARY STORAGE CONFIGURATION (IMAGE / FILE UPLOAD)
# ------------------------------------------------------------------------------
# Kredensial Cloudinary (Jika tidak diisi/dummy, sistem fallback ke local storage di /uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 8. GOOGLE PLACES API (GOOGLE REVIEWS SYNC)
# ------------------------------------------------------------------------------
# API Key dan Place ID untuk sinkronisasi rating & review dari Google Maps
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACE_ID=your_google_place_id

# ------------------------------------------------------------------------------
# 9. BUSINESS & SYSTEM DEFAULTS
# ------------------------------------------------------------------------------
# Nomor WhatsApp Admin untuk integrasi tombol kontak di template email (format 62...)
ADMIN_WA_NUMBER=6281234567890

# Password default akun pasien baru yang di-generate sistem
DEFAULT_PATIENT_PASSWORD=user123456
